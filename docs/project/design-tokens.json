{
  "version": "1.0.0",
  "default": "system",
  "scope": "App UI only; original sources never inverted",
  "light": {
    "background": "#F5F7FB",
    "surface": "#FFFFFF",
    "surface_raised": "#EDF2FA",
    "text": "#132238",
    "muted_text": "#455468",
    "border": "#687A91",
    "accent": "#165CC7",
    "on_accent": "#FFFFFF",
    "focus": "#174EB6",
    "success": "#17613A",
    "caution": "#80510A",
    "danger": "#A4222B",
    "unassessed": "#44556B"
  },
  "dark": {
    "background": "#111821",
    "surface": "#1A2532",
    "surface_raised": "#263444",
    "text": "#F4F7FB",
    "muted_text": "#B1BDCE",
    "border": "#7B8CA4",
    "accent": "#7AB5FF",
    "on_accent": "#102137",
    "focus": "#98C9FF",
    "success": "#78D59B",
    "caution": "#F4C477",
    "danger": "#FF9AA2",
    "unassessed": "#BDC8D7"
  },
  "typography": {
    "ui": "system-ui, Segoe UI, sans-serif",
    "math": "KaTeX renderer when installed; no font files bundled",
    "base_px": 16,
    "line_height": 1.5
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radius_px": 10,
  "motion": {
    "small_ms": 120,
    "panel_ms": 180,
    "reduced_motion_ms": 0
  },
  "component_guidance": "Touch target 44 CSS px preferred; icons labeled; focus and state never color-only. Actual contrast and rendered pairs must be tested."
}
