{
  "version": "2.0.0",
  "default": "system",
  "scope": "App UI only; original sources never inverted",
  "light": {
    "background": "#F2F4F8",
    "surface": "#F9FAFC",
    "surface_raised": "#FFFFFF",
    "text": "#15213A",
    "muted_text": "#4F5D75",
    "border": "#76849A",
    "hairline": "#E6E9ED",
    "accent": "#1D6AE5",
    "accent_hover": "#1C61D0",
    "on_accent": "#FFFFFF",
    "accent_text": "#0F5BDB",
    "tint": "#E8F0FC",
    "tint_strong": "#DFEAFB",
    "focus": "#0F4DB8",
    "success": "#1A6B3D",
    "caution": "#835307",
    "danger": "#A7242D",
    "unassessed": "#4B5B72"
  },
  "dark": {
    "background": "#171E27",
    "surface": "#202832",
    "surface_raised": "#252E39",
    "text": "#F1F4F9",
    "muted_text": "#B3BFCF",
    "border": "#7F8FA6",
    "hairline": "#3C4755",
    "accent": "#2E73DD",
    "accent_hover": "#2B69C7",
    "on_accent": "#FFFFFF",
    "accent_text": "#6AAFF8",
    "tint": "#233A5B",
    "tint_strong": "#243F65",
    "focus": "#A5D0FF",
    "success": "#72D49A",
    "caution": "#F1C272",
    "danger": "#FF9CA4",
    "unassessed": "#BAC6D5"
  },
  "wash_pct": {
    "ink": "text",
    "light": {
      "pad": 5,
      "pad_strong": 9,
      "pad_press": 13
    },
    "dark": {
      "pad": 7,
      "pad_strong": 11,
      "pad_press": 15
    }
  },
  "contrast_pairs": [
    {
      "fg": ["text", "muted_text", "success", "caution", "danger", "unassessed"],
      "bg": ["background", "surface", "surface_raised"],
      "min": 4.5,
      "use": "Text and state glyphs on the three grounds (the pairs of token version 1)."
    },
    {
      "fg": ["focus", "border"],
      "bg": ["background", "surface", "surface_raised"],
      "min": 3,
      "use": "Focus ring and control boundary on the three grounds (the pairs of token version 1)."
    },
    {
      "fg": ["on_accent"],
      "bg": ["accent", "accent_hover"],
      "min": 4.5,
      "use": "Glyph or label on the accent fill, at rest (a pair of token version 1) and on hover."
    },
    {
      "fg": ["accent"],
      "bg": ["background", "surface", "surface_raised"],
      "min": 3,
      "use": "The accent fill (play disc, primary button) against the ground it sits on."
    },
    {
      "fg": ["accent_text"],
      "bg": ["background", "surface", "surface_raised", "tint", "tint_strong", "pad@*"],
      "min": 4.5,
      "use": "Accent as text and as a mark: links, selected tab, current rail item, selected segment and its ring, played track, knob, selection rings."
    },
    {
      "fg": ["accent_text"],
      "bg": ["pad_strong@*", "pad_press@*"],
      "min": 3,
      "use": "An accent glyph or ring on a hovered or pressed control."
    },
    {
      "fg": ["text", "muted_text"],
      "bg": ["tint", "tint_strong", "pad@*", "pad_strong@*", "pad_press@*"],
      "min": 4.5,
      "use": "Labels on a selected item and on a neutral, hovered or pressed control."
    },
    {
      "fg": ["border"],
      "bg": ["pad@*"],
      "min": 3,
      "use": "A control boundary that sits on a wash."
    },
    {
      "fg": ["focus"],
      "bg": ["tint", "tint_strong", "pad_strong@*"],
      "min": 3,
      "use": "Focus ring around a selected or hovered item."
    },
    {
      "fg": ["success", "caution", "danger", "unassessed"],
      "bg": ["tint", "tint_strong", "pad@*"],
      "min": 3,
      "use": "State glyphs inside a selected row or node and on a wash."
    }
  ],
  "typography": {
    "ui": "system-ui, Segoe UI, sans-serif",
    "math": "KaTeX renderer when installed; no font files bundled",
    "base_px": 16,
    "line_height": 1.5,
    "weights": {
      "regular": 400,
      "strong": 600
    },
    "scale_from_px": [0, 900, 1440, 1920, 2400],
    "scale_px": {
      "micro": {"size": [12, 12, 12, 12, 13], "line": [16, 16, 16, 16, 18]},
      "meta": {"size": [13, 13, 13, 14, 14], "line": [18, 18, 18, 20, 20]},
      "ui": {"size": [14, 14, 14, 15, 16], "line": [20, 20, 20, 22, 24]},
      "read": {"size": [16, 16, 16, 17, 18], "line": [24, 24, 24, 26, 28]},
      "head": {"size": [18, 18, 18, 20, 20], "line": [24, 24, 24, 28, 28]},
      "title": {"size": [20, 22, 22, 24, 26], "line": [26, 28, 28, 30, 32]},
      "display": {"size": [24, 26, 28, 32, 36], "line": [30, 32, 34, 38, 44]}
    }
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius_px": 10,
  "radius_role_px": {
    "thumb": 6,
    "row": 8,
    "control": 10,
    "region": 14,
    "round": 999
  },
  "motion": {
    "small_ms": 120,
    "panel_ms": 180,
    "reduced_motion_ms": 0
  },
  "component_guidance": "Touch target 44 CSS px preferred; icons labeled; focus and state never color-only. Actual contrast and rendered pairs must be tested."
}
